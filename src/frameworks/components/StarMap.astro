---
import { pad } from '../../domain/format';
import { systemColor } from '../../adapters/system-colors';
import { getMapOrder, systems as cats } from '../../adapters/catalog';
import { getLang, localizePath, useTranslations } from '../../adapters/i18n';
import { webSrc } from '../../adapters/images';
import InProgressBadge from './InProgressBadge.astro';
import MapZoom from './MapZoom.astro';
import styles from '../styles/components/star-map.module.css';
import chromeStyles from '../styles/components/star-map-chrome.module.css';
import keyStyles from '../styles/components/star-map-keys.module.css';
import listStyles from '../styles/components/project-list.module.css';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const projects = getMapOrder(lang);

// Projets dans l'ordre de parcours de la carte (système par système, voir projects.ts) :
// c'est celui des numéros 01, 02…

const data = await Promise.all(projects.map(async (p) => ({
	slug: p.slug,
	title: p.title,
	description: p.description,
	cat: p.category,
	tag: p.tag,
	year: p.year,
	wip: !!p.inProgress,
	img: await webSrc(p.image, 720), // vignette (HUD, aperçu « View all ») : jamais affichée à plus de 640px
	alt: p.alt,
	link: localizePath(`/projects/${p.slug}`, lang),
})));

// Textes écrits par le moteur de la carte (src/frameworks/scripts/star-map/) : {name} et {n} y sont remplacés.
const text = {
	entering: t('map.entering'),
	system: t('map.system'),
	selected: t('map.selected'),
	project: t('map.project'),
	projects: t('map.projects'),
	targeting: t('map.targeting'),
	lock: t('map.lock'),
};

const systems = cats.map((c, g) => ({
	num: pad(g + 1),
	label: c,
	count: pad(projects.filter((p) => p.category === c).length),
}));
const filters = [{ key: 'All', label: t('map.filterAll'), count: pad(projects.length) }, ...systems.map((s) => ({ key: s.label, label: s.label, count: s.count }))];
---

<section class={styles.stage} data-starmap>
	<div id="work" class={styles['work-anchor']} data-work-anchor></div>
	<div class={styles.sticky}>
		<div class={styles['stars-layer']} data-stars aria-hidden="true"></div>

		<div class={styles['hero-slot']} data-hero-wrap>
			<slot />
		</div>

		<div class={styles['map-ui']} data-map-ui>
			<div class={styles['map-layer']} data-map></div>

			<div class={chromeStyles.topbar}>
				<div class={chromeStyles.counter} data-counter>01 / {pad(projects.length)}</div>
				<h2 class={chromeStyles.title} set:html={t('map.title')} />
				<button class={chromeStyles['see-all']} type="button" data-see-all>{t('map.viewAll')} ☰</button>
			</div>

			<div class={chromeStyles.nav}>
				<div class={chromeStyles['nav-heading']}>{t('map.systems')}</div>
				{systems.map((sys) => (
					<button class={chromeStyles['nav-row']} type="button" data-nav-row>
						<span class={chromeStyles['nav-dot']} style={`--c: ${systemColor(sys.label)}`}></span>
						<span>{sys.num}<span class={chromeStyles['nav-name']}>. {t('map.system', { name: sys.label })}</span></span>
						<span class={chromeStyles['nav-count']}>{sys.count}</span>
						<span class={chromeStyles['nav-bar']} data-nav-bar></span>
					</button>
				))}
			</div>

			<div class={chromeStyles.hud} data-hud>
				<div class={chromeStyles['hud-label']} data-hud-cat>{t('map.selected')}</div>
				<div class={chromeStyles['hud-img']}><img data-hud-img src="" alt="" draggable="false" /></div>
				<h3 class={chromeStyles['hud-title']}><span class={chromeStyles['title-text']} data-hud-title></span><InProgressBadge data-hud-wip hidden /></h3>
				<div class={chromeStyles['hud-meta']}>
					<span data-hud-tag></span>
					<span class={chromeStyles.sep}>-</span>
					<span data-hud-year></span>
				</div>
			</div>

			<a class={chromeStyles['about-link']} href="#about">{t('map.aboutLink')} ↓</a>

			<!-- Tactile : remplace le swipe dans la carte (affiché seulement sur écran tactile). -->
			<nav class={chromeStyles['touch-nav']} aria-label={t('map.touchAria')}>
				<button type="button" data-go="top" aria-label={t('map.top')}>↑</button>
				<button type="button" data-go="prev">← {t('map.prev')}</button>
				<button type="button" data-go="next">{t('map.next')} →</button>
				<button type="button" data-go="bottom" aria-label={t('map.bottom')}>↓</button>
			</nav>
		</div>

		<MapZoom projects={projects} />

		<!-- Raccourcis clavier : une ligne pour la carte, une pour la vue rapprochée. Chaque touche est
		     aussi un bouton (souris) qui fait la même chose ; hors du parcours au clavier, qui a les vraies touches. -->
		<div class={keyStyles.keys} data-keys aria-hidden="true">
			<span class={keyStyles['keys-map']}>
				<button type="button" class={keyStyles.key} data-key="ArrowLeft" tabindex="-1">←</button><button type="button" class={keyStyles.key} data-key="ArrowRight" tabindex="-1">→</button>
				{t('map.keyNavigate')}
				<button type="button" class={keyStyles.key} data-key="Enter" tabindex="-1">↵</button>
				{t('map.keyOpen')}
			</span>
			<span class={keyStyles['keys-zoom']}>
				<button type="button" class={keyStyles.key} data-key="ArrowLeft" tabindex="-1">←</button><button type="button" class={keyStyles.key} data-key="ArrowRight" tabindex="-1">→</button>
				{t('map.keyNavigate')}
				<button type="button" class={keyStyles.key} data-key="Enter" tabindex="-1">↵</button>
				{t('map.keyViewProject')}
				<button type="button" class:list={[keyStyles.key, keyStyles['key-word']]} data-key="Escape" tabindex="-1">esc</button>
				{t('map.keyClose')}
			</span>
		</div>
	</div>

	<!-- Overlay "Tout voir" -->
	<div class={listStyles.overlay} data-overlay role="dialog" aria-modal="true" aria-labelledby="overlay-title" inert>
		<div class={listStyles['overlay-inner']}>
			<div class={listStyles['overlay-head']}>
				<h2 class={listStyles['overlay-title']} id="overlay-title" set:html={t('map.allProjects')} />
				<button class={listStyles['overlay-close']} type="button" data-list-close>{t('map.close')} ✕</button>
			</div>
			<div class={listStyles['overlay-filters']}>
				{filters.map((fl) => (
					<button class={listStyles.chip} type="button" data-filter={fl.key}>
						{fl.label} <span class={listStyles['chip-count']}>{fl.count}</span>
					</button>
				))}
			</div>
			<div class={listStyles['overlay-grid']}>
				<div class={listStyles['overlay-rows']}>
					{projects.map((p, i) => (
						<button type="button" class={listStyles.row} data-row-idx={i} data-cat={p.category}>
							<span class={listStyles['row-num']}>{pad(i + 1)}</span>
							<span class={listStyles['row-main']}>
								<span class={listStyles['row-title']}>{p.title}{p.inProgress && <InProgressBadge />}</span>
								<span class={listStyles['row-tag']}>{p.tag}</span>
							</span>
							<span class={listStyles['row-year']}>{p.year} →</span>
						</button>
					))}
				</div>
				<div class={listStyles['overlay-preview']}>
					<div class={listStyles['preview-img']}><img data-preview-img src="" alt="" /></div>
					<p class={listStyles['preview-desc']} data-preview-desc></p>
				</div>
			</div>
		</div>
	</div>

	<!-- Repli sémantique : visible sans JS / reduced-motion, masqué quand la carte est active. -->
	<ul class={styles.fallback}>
		{projects.map((p, i) => (
			<li>
				<a href={localizePath(`/projects/${p.slug}`, lang)}>
					<span class={styles['f-num']}>{pad(i + 1)}</span>
					<span>{p.title} {p.inProgress && <InProgressBadge />}</span>
					<span class={styles['f-tag']}>{p.tag}</span>
				</a>
			</li>
		))}
	</ul>

	<script type="application/json" id="starmap-data" set:html={JSON.stringify(data)} />
	<script type="application/json" id="starmap-text" set:html={JSON.stringify(text)} />
</section>

<script>
	import styles from '../styles/components/star-map.module.css';
	import { initStarMap } from '../scripts/star-map';
	initStarMap(styles as unknown as Record<string, string>);
</script>
