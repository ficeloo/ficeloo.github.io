---
const currYear = new Date().getFullYear();
---

<header class="header">
	<div class="wordmark">
		<a href="/">ficelo<span class="wordmark-dot">.</span></a>
	</div>
	<nav>
		<a href="#work">Work</a>
		<a href="#contact">Contact</a>
	</nav>

	<div class="indicator">
		PORTFOLIO / {currYear}
	</div>
</header>

<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font-display);
		padding: 1rem 3%;
		border-bottom: 2px solid rgba(83, 121, 112, 0.34);
		line-height: 1;
		background-color: #131224;
	}

	.indicator {
		font-size: clamp(0.95rem, 2vw, 1.6rem);
		letter-spacing: 0.18em;
		color: rgba(243, 246, 246, 0.62);
	}

	nav {
		display: flex;
		flex: 1;
		gap: 2rem;
	}

	nav a{
		color: var(--color-text);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		text-decoration: none;
		font-size: clamp(1.25rem, 2vw, 3rem);
	}

	.wordmark {
		letter-spacing: 0.1em;
		flex: 1;
		text-decoration: none;
		color: var(--color-text);
		font-size: clamp(1.75rem, 2vw, 5rem);
	}

	.wordmark a {
		text-decoration: none;
		color: var(--color-text);
	}

	.wordmark-dot {
		color: var(--color-accent);
		font-size: clamp(1.2em, 2vw, 2em);
		position: relative;
		top: -0.03em;
	}

	@media(max-width: 768px) {
		.indicator { display: none; }
	}

</style>
