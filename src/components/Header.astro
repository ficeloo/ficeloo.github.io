---
import styles from '../styles/components/header.module.css'
import { getLang, languages, langs, localizePath, switchPath, useTranslations } from '../i18n'

interface Props {
	/** Présent sur une sous-page : nav « ← Back / Contact » et fil d'Ariane à droite. */
	crumb?: string;
	/** Cible de « ← Back » : le projet d'où l'on vient dans la carte, sinon son début. */
	back?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { crumb, back = localizePath('/#work', lang) } = Astro.props;
const currYear = new Date().getFullYear();
// Sélecteur de langue : seulement vers les langues publiées (live dans src/i18n/index.ts).
const others = langs.filter((l) => l !== lang && languages[l].live);
---

<header class={styles.header}>
	<div class={styles.wordmark}>
		<a href={localizePath('/', lang)}>ficelo<span class={styles["wordmark-dot"]}>.</span></a>
	</div>
	{crumb ? (
		<nav aria-label={t('nav.aria')}>
			<a href={back}><span class={styles.arrow}>←</span> {t('nav.back')}</a>
			<a href="#contact">{t('nav.contact')}</a>
		</nav>
	) : (
		<nav aria-label={t('nav.aria')}>
			<a href={localizePath('/#work', lang)}>{t('nav.work')}</a>
			<a href={localizePath('/#about', lang)}>{t('nav.about')}</a>
			<a href="#contact">{t('nav.contact')}</a>
		</nav>
	)}

	<div class={styles.end}>
		<div class={styles.indicator}>
			{crumb ?? t('header.indicator', { year: currYear })}
		</div>
		{others.length > 0 && (
			<div class={styles.lang} role="group" aria-label={t('lang.aria')}>
				{others.map((l) => (
					<a href={switchPath(Astro.url.pathname, l)} hreflang={l} lang={l} title={languages[l].label}>{languages[l].short}</a>
				))}
			</div>
		)}
	</div>
</header>
