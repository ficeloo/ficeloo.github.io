---
import ProjectCard from '../components/ProjectCard.astro'
import { projects } from '../data/projects';
import styles from '../styles/components/work.module.css'
---

<section id="work">
	<div class={styles["work-title"]}>
		<h1><span class="accent">Discover</span> my Work</h1>
	</div>

	<div class={styles.core}>
		{projects.map((project, i) => (
			<ProjectCard
				title={project.title}
				description={project.description}
				tag={project.tag}
				year={project.year}
				image={project.image}
				alt={project.alt}
				link={ `/projects/${project.slug}` }
				reverse={i % 2 === 1}
			/>
		))}
	</div>
</section>
