---
import { projects } from '../data/projects';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import styles from '../styles/components/star-map.module.css';

const pad = (n: number) => String(n).padStart(2, '0');

// Vignettes (HUD, popup, aperçu « View all ») : jamais affichées à plus de 640px de large.
// Un GIF est gardé tel quel, sinon la conversion lui ferait perdre son animation.
const thumb = async (img: ImageMetadata) =>
	img.format === 'gif' ? img.src : (await getImage({ src: img, width: 720, format: 'webp' })).src;

const data = await Promise.all(projects.map(async (p) => ({
	slug: p.slug,
	title: p.title,
	description: p.description,
	cat: p.category,
	tag: p.tag,
	year: p.year,
	img: await thumb(p.image),
	alt: p.alt,
})));

const cats = [...new Set(projects.map((p) => p.category))];
const systems = cats.map((c, g) => ({
	num: pad(g + 1),
	label: c,
	count: pad(projects.filter((p) => p.category === c).length),
}));
const filters = [{ key: 'All', label: 'All', count: pad(projects.length) }, ...systems.map((s) => ({ key: s.label, label: s.label, count: s.count }))];
---

<section class={styles.stage} data-starmap>
	<div id="work" class={styles['work-anchor']} data-work-anchor></div>
	<div class={styles.sticky}>
		<div class={styles['stars-layer']} data-stars aria-hidden="true"></div>

		<div class={styles['hero-slot']} data-hero-wrap>
			<slot />
		</div>

		<div class={styles['map-ui']} data-map-ui>
			<div class={styles['map-layer']} data-map></div>

			<div class={styles.topbar}>
				<div class={styles.counter} data-counter>01 / {pad(projects.length)}</div>
				<h2 class={styles.title}><span class="accent">Discover</span> my Work</h2>
				<button class={styles['see-all']} type="button" data-see-all>View all ☰</button>
			</div>

			<div class={styles.nav}>
				<div class={styles['nav-heading']}>Systems</div>
				{systems.map((sys) => (
					<button class={styles['nav-row']} type="button" data-nav-row>
						<span>{sys.num}<span class={styles['nav-name']}>. {sys.label} System</span></span>
						<span class={styles['nav-count']}>{sys.count}</span>
						<span class={styles['nav-bar']} data-nav-bar></span>
					</button>
				))}
			</div>

			<div class={styles.hud} data-hud>
				<div class={styles['hud-label']} data-hud-cat>Selected</div>
				<div class={styles['hud-img']}><img data-hud-img src="" alt="" draggable="false" /></div>
				<h3 class={styles['hud-title']} data-hud-title></h3>
				<div class={styles['hud-meta']}>
					<span data-hud-tag></span>
					<span class="sep">-</span>
					<span data-hud-year></span>
				</div>
			</div>

			<a class={styles['about-link']} href="#about">About me ↓</a>

			<!-- Tactile : remplace le swipe dans la carte (affiché seulement sur écran tactile). -->
			<nav class={styles['touch-nav']} aria-label="Projects">
				<button type="button" data-go="top" aria-label="Back to top">↑</button>
				<button type="button" data-go="prev">← Prev</button>
				<button type="button" data-go="next">Next →</button>
				<button type="button" data-go="bottom" aria-label="Go to the bottom of the page">↓</button>
			</nav>
		</div>

		<div class={styles.backdrop} data-backdrop></div>
		<svg class={styles.beam} data-beam aria-hidden="true">
			<defs>
				<linearGradient id="beamG" x1="0" y1="1" x2="0" y2="0">
					<stop offset="0" stop-color="#FD6035" stop-opacity="0.5"></stop>
					<stop offset="1" stop-color="#FD6035" stop-opacity="0.03"></stop>
				</linearGradient>
			</defs>
			<polygon data-beam-poly points="" fill="url(#beamG)"></polygon>
		</svg>
		<div class={styles.popup} data-popup>
			<div class={styles['popup-scanlines']}></div>
			<div class={`${styles['popup-corner']} ${styles['corner-tl']}`}></div>
			<div class={`${styles['popup-corner']} ${styles['corner-tr']}`}></div>
			<div class={`${styles['popup-corner']} ${styles['corner-bl']}`}></div>
			<div class={`${styles['popup-corner']} ${styles['corner-br']}`}></div>
			<div class={styles['popup-row']}>
				<div class={styles['popup-img']}><img data-popup-img src="" alt="" /></div>
				<div class={styles['popup-body']}>
					<div class={styles['popup-meta']}>
						<span data-popup-meta></span>
						<button class={styles['popup-close']} type="button" data-popup-close>✕</button>
					</div>
					<h3 class={styles['popup-title']} data-popup-title></h3>
					<p class={styles['popup-desc']} data-popup-desc></p>
					<div class={styles['popup-tagyear']}>
						<span data-popup-tag></span>
						<span class="sep">-</span>
						<span data-popup-year></span>
					</div>
					<div class={styles['popup-link-wrap']}>
						<a class={styles['popup-link']} data-popup-link href="#">View project →</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Raccourcis clavier : une ligne pour la carte, une pour la popup ouverte. -->
		<div class={styles.keys} data-keys aria-hidden="true">
			<span class={styles['keys-map']}><kbd>←</kbd><kbd>→</kbd> navigate <kbd>↵</kbd> open</span>
			<span class={styles['keys-popup']}><kbd>↵</kbd> view project <kbd>esc</kbd> close</span>
		</div>
	</div>

	<!-- Overlay "Tout voir" -->
	<div class={styles.overlay} data-overlay>
		<div class={styles['overlay-inner']}>
			<div class={styles['overlay-head']}>
				<h2 class={styles['overlay-title']}>All <span class="accent">projects</span></h2>
				<button class={styles['overlay-close']} type="button" data-list-close>Close ✕</button>
			</div>
			<div class={styles['overlay-filters']}>
				{filters.map((fl) => (
					<button class={styles.chip} type="button" data-filter={fl.key}>
						{fl.label} <span class={styles['chip-count']}>{fl.count}</span>
					</button>
				))}
			</div>
			<div class={styles['overlay-grid']}>
				<div class={styles['overlay-rows']}>
					{projects.map((p, i) => (
						<div class={styles.row} data-row-idx={i} data-cat={p.category}>
							<span class={styles['row-num']}>{pad(i + 1)}</span>
							<div class={styles['row-main']}>
								<span class={styles['row-title']}>{p.title}</span>
								<span class={styles['row-tag']}>{p.tag}</span>
							</div>
							<span class={styles['row-year']}>{p.year} →</span>
						</div>
					))}
				</div>
				<div class={styles['overlay-preview']}>
					<div class={styles['preview-img']}><img data-preview-img src="" alt="" /></div>
					<p class={styles['preview-desc']} data-preview-desc></p>
				</div>
			</div>
		</div>
	</div>

	<!-- Repli sémantique : visible sans JS / reduced-motion, masqué quand la carte est active. -->
	<ul class={styles.fallback}>
		{projects.map((p, i) => (
			<li>
				<a href={`/projects/${p.slug}`}>
					<span class={styles['f-num']}>{pad(i + 1)}</span>
					<span>{p.title}</span>
					<span class={styles['f-tag']}>{p.tag}</span>
				</a>
			</li>
		))}
	</ul>

	<script type="application/json" id="starmap-data" set:html={JSON.stringify(data)} />
</section>

<script>
	import styles from '../styles/components/star-map.module.css';
	import { initStarMap } from '../scripts/star-map';
	initStarMap(styles as unknown as Record<string, string>);
</script>
