---
import SectionHead from '../project/SectionHead.astro';
import PhotoFrame from './PhotoFrame.astro';
import type { ProjectEvent } from '../../data/events';
import styles from '../../styles/components/event/event-days.module.css';
import { getLang, useTranslations } from '../../i18n';

interface Props {
	days: ProjectEvent['days'];
}

// Le déroulé de l'événement en « journal de bord » : une frise verticale, un point par jour,
// la date et le titre à gauche, le récit au milieu, la photo du jour à droite.
const { days } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<section class={styles.section}>
	<SectionHead title={t('event.days')} />
	<ol class={styles.days}>
		{days.map((d, i) => (
			<li class={styles.day}>
				<div class={styles.meta}>
					<span class={styles.date}>{t('event.day', { n: i + 1 })} · {d.date}</span>
					<h3 class={styles.title}>{d.title}</h3>
				</div>
				<div class={styles.text} set:html={d.text} />
				{d.photo && (
					<div class={styles.photo}>
						<PhotoFrame image={d.photo.image} alt={d.photo.alt} ratio="16 / 10" />
					</div>
				)}
			</li>
		))}
	</ol>
</section>
