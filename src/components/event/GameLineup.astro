---
import SectionHead from '../project/SectionHead.astro';
import type { ProjectEvent } from '../../data/events';
import styles from '../../styles/components/event/game-lineup.module.css';
import { getLang, useTranslations } from '../../i18n';

interface Props {
	games: ProjectEvent['games'];
}

// Les jeux de l'événement en « bande segmentée », comme une barre de programme sur un stream :
// une case par jeu avec un repère dans la teinte du système, le jeu mystère mis en avant avec un « ? ».
const { games } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<section class={styles.section}>
	<SectionHead title={t('event.games')} />
	<ul class={styles.strip}>
		{games.map((g) => (
			<li class:list={[styles.game, g.mystery && styles.mystery]}>
				<span class={styles.name}>
					{g.mystery && <span class={styles.mark} aria-hidden="true">?</span>}
					{g.name}
				</span>
				{g.note && <span class={styles.note}>{g.note}</span>}
			</li>
		))}
	</ul>
</section>
