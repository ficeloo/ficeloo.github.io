---
import SectionHead from '../project/SectionHead.astro';
import PhotoFrame from './PhotoFrame.astro';
import type { ProjectEvent } from '../../data/events';
import styles from '../../styles/components/event/on-air.module.css';
import { getLang, useTranslations } from '../../i18n';

interface Props {
	photos: NonNullable<ProjectEvent['onAir']>;
}

// Captures du stream, chacune dans un cadre HUD avec sa légende.
const { photos } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<section class={styles.section}>
	<SectionHead title={t('event.onAir')} />
	<p class={styles.hint}>{t('event.onAirHint')}</p>
	<div class={styles.grid}>
		{photos.map((p) => (
			<figure class={styles.figure}>
				<PhotoFrame image={p.image} alt={p.alt} />
				{p.caption && <figcaption class={styles.caption}>{p.caption}</figcaption>}
			</figure>
		))}
	</div>
</section>
