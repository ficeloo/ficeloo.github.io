---
import { getMapOrder, systems, type Project } from '../../data/projects';
import { getLang, localizePath, useTranslations } from '../../i18n';
import styles from '../../styles/components/project/system-map.module.css';

interface Props {
	project: Project;
}

// Mini-carte du système : les astres du même système (ordre de la carte), celui-ci en
// surbrillance, et des liens vers les systèmes voisins (dernier astre du précédent,
// premier astre du suivant : les voisins directs sur la carte).
const { project } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const mapOrder = getMapOrder(lang);
const bodies = mapOrder.filter((p) => p.category === project.category);
const index = systems.indexOf(project.category);
const prevSystem = systems[index - 1];
const nextSystem = systems[index + 1];
const prevBody = prevSystem && mapOrder.findLast((p) => p.category === prevSystem);
const nextBody = nextSystem && mapOrder.find((p) => p.category === nextSystem);
const pad = (n: number) => String(n).padStart(2, '0');
---

<nav class={styles.sysmap} aria-label={t('map.system', { name: project.category })}>
	<span class={styles.label}>{t('map.system', { name: project.category })} · {pad(bodies.length)} {t(bodies.length > 1 ? 'project.bodies' : 'project.body')}</span>
	<div class={styles.track}>
		{prevBody && <a class:list={[styles.jump, styles.prev]} href={localizePath(`/projects/${prevBody.slug}`, lang)}>← {t('map.system', { name: prevSystem })}</a>}
		<div class={styles.bodies}>
		{bodies.map((b) => {
			const current = b.slug === project.slug;
			return (
				<a class:list={[styles.body, current && styles.current]} href={localizePath(`/projects/${b.slug}`, lang)} aria-current={current ? 'page' : undefined} style={`--c: var(--planet-${b.slug})`}>
					<span class={styles.dot}></span>
					<span>{b.title}</span>
					{current && <small>{t('project.here')}</small>}
				</a>
			);
		})}
		</div>
		{nextBody && <a class:list={[styles.jump, styles.next]} href={localizePath(`/projects/${nextBody.slug}`, lang)}>{t('map.system', { name: nextSystem })} →</a>}
	</div>
</nav>
