---
import SectionHead from './SectionHead.astro';
import type { Project } from '../../data/projects';
import styles from '../../styles/components/project/highlights.module.css';

interface Props {
	highlights: NonNullable<Project['highlights']>;
}

// Cartes sur une grille de 6 colonnes : 3 par rangée, et la dernière rangée s'élargit
// pour ne jamais laisser une carte seule (5 → 3 + 2, 4 → 2 + 2, 7 → 3 + 2 + 2).
const { highlights } = Astro.props;
const n = highlights.length;
const span = (i: number) => {
	if (n === 1) return 6;
	if (n === 4) return 3;
	if (n % 3 === 2 && i >= n - 2) return 3;
	if (n % 3 === 1 && i >= n - 4) return 3;
	return 2;
};
---

<section class={styles.section}>
	<SectionHead title="Highlights" />
	<ul class={styles.grid}>
		{highlights.map((h, i) => (
			<li class={styles.card} style={`--span: ${span(i)}`}>
				<span class={styles.label}>{h.label}</span>
				<h3 class={styles.title}>{h.title}</h3>
				<p class={styles.text}>{h.text}</p>
			</li>
		))}
	</ul>
</section>
