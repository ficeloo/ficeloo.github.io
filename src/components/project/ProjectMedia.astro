---
import { pad } from '../../domain/format';
import { webSrc } from '../../adapters/images';
import type { Project } from '../../domain/project';
import styles from '../../styles/components/project/project-media.module.css';
import { getLang, useTranslations } from '../../adapters/i18n';

interface Props {
	project: Project;
}

// Média principal dans un cadre HUD + vignettes. Le défilement (façon Steam) est géré
// par src/scripts/project-gallery.ts ; flèches et compteur restent masqués sans JS.
const { project } = Astro.props;
const isGif = project.image.format === 'gif';
const t = useTranslations(getLang(Astro.currentLocale));

const shots = [project.image, ...(project.screenshots ?? [])];
const slides = await Promise.all(shots.map(async (img, i) => ({
	src: await webSrc(img, 1280),
	thumb: await webSrc(img, 360),
	alt: i === 0 ? project.alt : t('media.screenshot', { title: project.title, n: i }),
})));
---

<div class={styles.media} data-gallery>
	<div class={styles.frame}>
		<span class={styles.corner}></span><span class={styles.corner}></span>
		<span class={styles.corner}></span><span class={styles.corner}></span>
		<div class={styles.screen}>
			<img data-main src={slides[0].src} alt={slides[0].alt} width={project.image.width} height={project.image.height} loading="eager" />
			<span class={styles.rec}>{isGif ? t('media.rec') : t('media.preview')}</span>
			{slides.length > 1 && (
				<>
					<button type="button" class:list={[styles.nav, styles.prev]} data-prev hidden aria-label={t('media.prev')}>‹</button>
					<button type="button" class:list={[styles.nav, styles.next]} data-next hidden aria-label={t('media.next')}>›</button>
					<span class={styles.count} data-count hidden>01 / {pad(slides.length)}</span>
				</>
			)}
		</div>
	</div>
	{slides.length > 1 && (
		<div class={styles.thumbs}>
			{slides.map((s, i) => (
				<button type="button" class={styles.thumb} data-slide={s.src} data-alt={s.alt} aria-label={t('media.show', { n: i + 1 })} aria-current={i === 0 ? 'true' : undefined}>
					<img src={s.thumb} alt="" loading="lazy" />
				</button>
			))}
		</div>
	)}
</div>

<script>
	import '../../scripts/project-gallery';
</script>
