---
import InProgressBadge from '../InProgressBadge.astro';
import type { Project } from '../../data/projects';
import styles from '../../styles/components/project/spec-sheet.module.css';
import { getLang, useTranslations } from '../../i18n';

interface Props {
	project: Project;
}

// Fiche technique : ce qu'un recruteur lit en quelques secondes, et tous les liens du projet.
const { project } = Astro.props;
const { links } = project;
const t = useTranslations(getLang(Astro.currentLocale));
// « Play » mène au jeu de la page s'il est intégré, sinon à itch.io
const play = project.embedUrl ? '#play' : links.itch;
---

<aside class={styles.spec} aria-label={t('spec.title')}>
	<div class={styles.head}>
		<span class={styles.label}>{t('spec.title')}</span>
		{project.inProgress ? <InProgressBadge /> : <span class={styles.status}>{t(project.event ? 'spec.done' : 'spec.shipped')}</span>}
	</div>
	<dl class={styles.rows}>
		<div class={styles.row}><dt>{t('spec.context')}</dt><dd>{project.context}</dd></div>
		{project.duration && <div class={styles.row}><dt>{t('spec.duration')}</dt><dd>{project.duration}</dd></div>}
		<div class={styles.row}><dt>{t(project.inProgress ? 'spec.started' : project.event ? 'spec.date' : 'spec.released')}</dt><dd>{project.year}</dd></div>
		<div class={styles.row}><dt>{t(project.event ? 'spec.skills' : 'spec.stack')}</dt><dd>{project.stack.join(' · ')}</dd></div>
	</dl>
	<div class={styles.links}>
		{play && <a href={play}><span>{t('spec.play')}</span><span>itch.io</span></a>}
		{links.github && <a href={links.github}><span>{t('spec.source')}</span><span>GitHub</span></a>}
		{links.gdd && <a href={links.gdd}><span>{t('spec.gdd')}</span><span>GDD</span></a>}
		{links.replay && <a href={links.replay}><span>{t('spec.replay')}</span><span>YouTube</span></a>}
		{links.site && <a href={links.site}><span>{t('spec.site')}</span><span>{new URL(links.site).hostname}</span></a>}
	</div>
</aside>
