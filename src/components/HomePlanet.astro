---
import { projects } from '../data/projects';
import { TILT, FLAT, VIEWBOX, PLANET_R, RING_BANDS, projectSphere, latitudePath } from '../scripts/home-planet';
import styles from '../styles/components/home-planet.module.css';

const viewBox = `${VIEWBOX.x} ${VIEWBOX.y} ${VIEWBOX.width} ${VIEWBOX.height}`;

// Légende HUD : une lune par projet, et les coordonnées de Paris.
const count = String(projects.length).padStart(2, '0');
const plural = projects.length > 1 ? 's' : '';

// Bandes de la géante gazeuse : des parallèles de la sphère, donc courbées comme elle.
// lat en degrés, width en unités du SVG, tone = teinte (voir le module CSS).
const stripes = [
	{ lat: -62, width: 6, tone: 'dark', opacity: 0.9 },
	{ lat: -46, width: 9, tone: 'light', opacity: 0.55 },
	{ lat: -32, width: 3, tone: 'dust', opacity: 0.5 },
	{ lat: -18, width: 11, tone: 'dark', opacity: 0.9 },
	{ lat: -4, width: 5, tone: 'light', opacity: 0.6 },
	{ lat: 10, width: 14, tone: 'mid', opacity: 0.9 },
	{ lat: 25, width: 3, tone: 'dust', opacity: 0.55 },
	{ lat: 38, width: 10, tone: 'dark', opacity: 0.9 },
	{ lat: 55, width: 6, tone: 'light', opacity: 0.5 },
];

// Petite tempête ovale, posée sur la sphère.
const [stormX, stormY] = projectSphere((-22 * Math.PI) / 180, (60 * Math.PI) / 180);
---

<div class={styles.planet}>
	<svg viewBox={viewBox} aria-hidden="true" data-planet>
		<defs>
			<clipPath id="home-planet-disc"><circle r={PLANET_R} /></clipPath>
			<!-- Moitié avant de l'anneau : y > 0 dans le repère incliné (côté spectateur). -->
			<clipPath id="home-planet-front"><rect x={VIEWBOX.x} y="0" width={VIEWBOX.width} height={VIEWBOX.height} /></clipPath>
			<radialGradient id="home-planet-shade" cx="34%" cy="28%" r="80%">
				<stop offset="0%" class={styles['shade-light']} />
				<stop offset="55%" class={styles['shade-clear']} />
				<stop offset="100%" class={styles['shade-dark']} />
			</radialGradient>
			<g id="home-planet-ring">
				{RING_BANDS.map((b) => (
					<ellipse class={styles[b.tone]} rx={b.r} ry={b.r * FLAT} stroke-opacity={b.opacity} stroke-width={b.width} />
				))}
			</g>
		</defs>

		<!-- L'anneau est dessiné deux fois : moitié arrière sous la planète, moitié avant par-dessus. -->
		<g transform={`rotate(${TILT})`}>
			<use href="#home-planet-ring" class={styles['ring-back']} />
			<g clip-path="url(#home-planet-disc)">
				<circle r={PLANET_R} class={styles.base} />
				{stripes.map((s) => (
					<path d={latitudePath(s.lat)} class={styles[`stripe-${s.tone}`]} stroke-width={s.width} stroke-opacity={s.opacity} />
				))}
				<ellipse cx={stormX} cy={stormY} rx="9" ry="4" class={styles.storm} />
				<ellipse cx={stormX} cy={stormY} rx="5" ry="2" class={styles['storm-eye']} />
				<circle r={PLANET_R} fill="url(#home-planet-shade)" />
			</g>
			<use href="#home-planet-ring" clip-path="url(#home-planet-front)" class={styles['ring-front']} />
		</g>
	</svg>
	<div class={styles.hud}>
		<span><b>{count}</b> moon{plural} · <b>{count}</b> project{plural}</span>
		<span><b>48.85° N</b> · <b>2.35° E</b></span>
	</div>
</div>
