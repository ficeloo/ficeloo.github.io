---
import styles from '../styles/components/hero.module.css'
---

<section class={styles.hero} data-hero>
	<div class={`${styles["status-pill"]} ${styles.reveal}`} style="--i:0">
		<span class={styles.dot}></span>Currently learning · 42 School · Paris
	</div>

	<h1 class={styles.reveal} style="--i:1">I'm <span class={styles.name}>ficelo</span>, <br /> a junior game designer & developer.</h1>

	<p class={`${styles.lede} ${styles.reveal}`} style="--i:2">With my games, I'm exploring ways to leave a mark. Small projects and a lot of fun — trying to do better every time.</p>

	<div class={`${styles["hero-meta"]} ${styles.reveal}`} style="--i:3">
		<span><span class={styles.label}>Based</span><strong>Paris, Fr</strong></span>
		<span class={styles.sep}>/</span>
		<span><span class={styles.label}>School</span><strong>42 (In progress)</strong></span>
		<span class={styles.sep}>/</span>
		<span><span class={styles.label}>Currently</span><strong>Rust · Bevy · Ts</strong></span>
		<span class={styles.sep}>/</span>
		<span><span class={styles.label}>Looking for</span><strong>First internship</strong></span>
	</div>

	<div class={`${styles["hero-cta"]} ${styles.reveal}`} style="--i:4">
		<a href="#work" class={styles.primary}>See my work <span class={styles.arrow}>→</span></a>
		<a href="#contact" class={styles.secondary}>Say hi ! <span class={styles.arrow}>→</span></a>
	</div>
</section>

<script>
	// Entrée en cascade au chargement. Le champ d'étoiles est désormais fourni
	// par la star map (le Hero se dissout dedans au scroll).
	const hero = document.querySelector('[data-hero]');
	hero?.setAttribute('data-ready', '');
</script>
