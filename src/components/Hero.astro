---
---

<section class="hero">
	<div class="hero-content">
		<h1>I'm <span class="accent">ficelo</span>, a junior game designer & developer.</h1>
		<p>With my games, I'm exploring ways to leave a mark.</p>
	</div>
	<div class="hero-cta">
		<a href="#work">See my work !</a>
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;

		gap: 5rem;
		padding: 1rem 3%;
		min-height: 100vh;
	}

	.accent {
		color: var(--color-accent);
	
	}

	.hero-content {
		letter-spacing: 0.1em;

	}

	.hero-content h1 {
		font-size: clamp(2rem, 3vw, 4rem);
	}

	.hero-content p {
		font-size: clamp(1.5rem, 2vw, 4rem);
		color: rgba(243, 246, 246, 0.80);
	}

	.hero-cta {
		align-self: end;
		margin-right: 20rem;
		font-size: clamp(1rem, 1.75vw, 4rem);
	}

	.hero-cta a {
		display: inline-block;
		color: var(--color-text);
		text-decoration: none;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.hero-cta:hover a {
		background: var(--color-accent);
		color: var(--color-bg);
	}

	html {
		scroll-behavior: smooth;
	}

</style>
