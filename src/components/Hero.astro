---
import styles from '../styles/components/hero.module.css'
---

<section class={styles.hero}>
	<div class={styles["status-pill"]}>
		<span class={styles.dot}></span>Currently learning · 42 School · Paris
	</div>
	<div class={styles["hero-content"]}>
		<h1>I'm <span class="accent">ficelo</span>,<br /> a junior game designer & developer.</h1>
		<p>With my games, I'm exploring ways to leave a mark. Small projects and a lot of fun — trying to do better every time.</p>
	</div>
	<div class={styles["hero-meta"]}>
		<span><strong>Based</strong>&nbsp;&nbsp;Paris, Fr</span>
		<span class={styles.separator}>|</span>
		<span><strong>School</strong>&nbsp;&nbsp;42 (In progress)</span>
		<span class={styles.separator}>|</span>
		<span><strong>Currently</strong>&nbsp;&nbsp;Rust · Bevy · Ts</span>
		<span class={styles.separator}>|</span>
		<span><strong>Looking for</strong>&nbsp;&nbsp;First internship</span>
	</div>
	<div class={styles["hero-cta"]}>
		<a href="#work" class={styles.primary}>See my work <span class={styles.arrow}>→</span></a>
		<a href="#contact" class={styles.secondary}>Say hi ! <span class={styles.arrow}>→</span></a>
	</div>
</section>
