---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import styles from '../styles/components/project-card.module.css'

interface Props {
	title:	string;
	description:	string;
	tag:	string;
	year:	string;
	image:	ImageMetadata;
	alt:	string;
	link:	string;
	reverse?:	boolean;
}

const { title, description, tag, year, image, alt, link, reverse = false } = Astro.props;
---

<article class={`${styles.card}${reverse ? ` ${styles.reverse}` : ''}`}>
<!-- Zone Image -->
	<div class={styles.image}>
		<Image src={image} alt={alt} />
	</div>

<!-- Zone Contenue -->
	<div class={styles.content}>
		<h3>{title}</h3>

		<p class={styles.description}>{description}</p>
		<div class={styles.meta}>
			<span>{tag}</span>
			<span class="accent">  -  </span>
			<span>{year}</span>
		</div>
		<div class={styles.cta}>
			<a href={link} rel="noopener noreferrer">View project <span class={styles.arrow}>→</span></a>
		</div>
	</div>
</article>
