---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	title:	string;
	description:	string;
	tag:	string;
	year:	number;
	image:	ImageMetadata;
	alt:	string;
	link:	string;
}

const { title, description, tag, year, image, alt, link } = Astro.props;
---

<article class="project-card">
<!-- Zone Image -->
	<Image src={image} alt={alt} />

<!-- Zone Contenue -->
	<div class="content">
		<h3>{title}</h3>

		<p class="description">{description}</p>
		<p class="meta">
			{tag}  ·  {year}
		</p>
		<a href={link} target="_blank" rel="noopener noreferrer">View project !</a>
	</div>

	
</article>
