---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Background from '../components/Background.astro'
import styles from '../styles/layouts/layout.module.css'
import '../styles/tokens.css'
import '../styles/global.css'

interface Props {
	title: string;
	/** Résumé de la page pour Google et les aperçus de partage. */
	description: string;
	/** Fil d'Ariane des sous-pages (ex. "Project / Stellar Drift") ; absent sur l'accueil. */
	crumb?: string;
	/** Cible du lien « ← Back » des sous-pages (par défaut : début de la carte). */
	back?: string;
}

const { title, description, crumb, back } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- ?v= : à incrémenter quand le favicon change (les navigateurs le gardent longtemps en cache). -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<Background />
		<div class={styles.page}>
			<Header crumb={crumb} back={back} />
			<slot />
			<Footer />
		</div>
	</body>
</html>
