---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import { Image } from 'astro:assets';
import styles from '../../styles/pages/project.module.css'

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
---

<Layout title={project.title}>
	<div class={styles.project}>
		<h1>{project.title}</h1>
		<div class={styles.tag}>
			{project.tag} <span class="accent">—</span> {project.year}
		</div>
		<div class={styles.links}>
			{project.links?.itch && <a class={styles.first} href={project.links.itch}>&#9655; Play in browser</a>}
			{project.links?.github && <a class={project.links.itch ? styles.second : styles.first} href={project.links.github}>&lt;/&gt; Code</a>}
			{project.links?.gdd && <a class={styles.second} href={project.links.gdd}>🗎 GDD</a>}
		</div>
		<div class={styles["main-img"]} >
			<img id="main" src={project.image.src} alt={project.alt} />
		</div>
		{project.screenshots && project.screenshots.length > 0 &&
			(<div class={styles.gallery}>
				{project.screenshots.map((shot) => (
					<Image class={styles.thumb} data-thumb src={shot} alt="" />
				))}
			</div>
		)}
		<div class={styles.description} >
			<h3><span class="accent">Project description</span></h3>
			<span set:html={project.longDescription}/>
		</div>
		{project.embedUrl &&
			(<div class={styles.embed}>
				Play it here
				<iframe src={project.embedUrl} width="1280"/>
				<p class={styles["on-mobile"]}>This game is not designed to run on your device. Try it on a computer !</p>
			</div>
		)}
	</div>
</Layout>

<script>
	const mainImage = document.getElementById('main') as HTMLImageElement;
	const thumbnails = document.querySelectorAll('[data-thumb]') as NodeListOf<HTMLImageElement>;

	const originalSrc = mainImage.src;

	let revertTimer = 0;

	thumbnails.forEach(thumb => {
		thumb.addEventListener('click', () => {
			if (!mainImage)
				return;


			mainImage.style.opacity = '0.6';

			setTimeout(() => {
				mainImage.src = thumb.src;
				mainImage.style.opacity = '1';
			}, 150);

			clearTimeout(revertTimer);
			revertTimer = setTimeout(() => {
				mainImage.style.opacity = '0.6';
				setTimeout(() => {
					mainImage.src = originalSrc;
					mainImage.style.opacity = '1';
				}, 150);
			}, 10000);
		});
	});
</script>
