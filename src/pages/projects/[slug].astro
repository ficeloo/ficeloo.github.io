---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import { Image } from 'astro:assets';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
---

<Layout title={project.title}>
	<div class="project">
		<h1>{project.title}</h1>
		<div class="tag">
			{project.tag} <span class="accent">—</span> {project.year}
		</div>
		<div class="links">
			{project.links?.itch && <a class="first" href={project.links.itch}>&#9655; Play in browser</a>}
			{project.links?.github && <a class={project.links.itch ? "second" : "first"} href={project.links.github}>&lt;/&gt; Code</a>}
			{project.links?.gdd && <a class="second" href={project.links.gdd}>🗎 GDD</a>}
		</div>
		<div class="main-img" >
			<img id="main" src={project.image.src} alt={project.alt} />
		</div>
		{project.screenshots && project.screenshots.length > 0 &&
			(<div class="gallery">
				{project.screenshots.map((shot) => (
					<Image class="thumb" src={shot} alt="" />
				))}
			</div>
		)}
		<div class="description" >
			<h3><span class="accent">Project description</span></h3>
			<span set:html={project.longDescription}/>
		</div>
		{project.embedUrl &&
			(<div class="embed">
				Play it here
				<iframe src={project.embedUrl} width="1280"/>
				<p class="on-mobile">This game is not designed to run on your device. Try it on a computer !</p>
			</div>
		)}
	</div>
</Layout>

<style>

	.project {
		display: flex;
		flex-direction: column;
		padding: 1em;
		font-size: clamp(0.5rem, 1rem, 3rem);
		gap: 1em;
		max-width: 80rem;
		margin: 0 auto;
	}

	h1 {
		letter-spacing: 0.1em;
		font-weight: normal;
	}

	.tag {
		text-transform: uppercase;
		font-family: var(--font-display);
		color: rgba(243,246,246, 0.62);
	}

	.links {
		display: flex;

		font-family: var(--font-display);
		font-size: 0.95em;;
		text-transform: uppercase;
		gap: 1em;

	}

	.links a {
		display: inline-flex;
		text-decoration: none;
		align-items: center;

		border-radius: 5px;
		padding: 0.4rem 0.5rem;

		transition: transform 0.25s,
		background-color 0.25s;
	}

	.links a:hover {
		transform: scale(1.05);
	}

	.first {
		align-items: center;

		background-color: var(--color-accent);
		
		color: var(--color-bg);
	}

	.first:hover {
		background-color: color-mix(in srgb, var(--color-accent) 85%, white);
	}

	.second {
		color: var(--color-text);
		border: 1px solid;
	}

	.second:hover {
		background-color: color-mix(in srgb, var(--color-bg) 85%, white);
	}

	.main-img img {
		width: 100%;
		border-radius: 5px;
		border: 1px solid rgba(83, 121, 112, 0.4);
		transition: opacity 0.15s ease-in-out;
	}

	.gallery {
		display: flex;
		gap: 12px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		border-radius: 5px;
		scrollbar-width: thin;
		scrollbar-color: rgba(83,121,112,0.6) transparent;
	}

	.gallery img {
		aspect-ratio: 16/9;
		object-fit: cover;
		scroll-snap-align: start;
		border: 1px solid rgba(83, 121, 112, 0.4);
		border-radius: 5px;
	}

	.thumb {
		width: 27%;
		height: auto;
	}

	.description {
		padding: 1rem 0rem;
		color: var(--color-text);
		border-bottom: 1px solid rgba(83, 121, 112, 0.4);
	}

	.description span:nth-child(1) {
		font-size: 1.1em;
	}

	.description :global(p) {
		line-height: 1.4;
	}

	.description :global(div){
		font-size: 0.9em;
		color:  color-mix(in srgb, var(--color-text) 80%, black);
	}

	.description :global(ul){
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.description h3 {
		font-weight: normal;
	}

	.embed {
		display: flex;
		flex-direction: column;
		text-transform: uppercase;
		font-family: var(--font-display);
		color:  color-mix(in srgb, var(--color-text) 70%, black);
		gap: 1rem;
	}

	.embed iframe {
		display: none;
	}

	.on-mobile {
		display: flex;
		justify-content: center;
		color: white;
	}


	@media(min-width: 1280px) {
		.on-mobile {display: none;}
		.embed iframe {
			display: flex;
			align-items: start;
			border: 1px solid;
			aspect-ratio: 16/9;
			margin: 1rem auto;
			allow: autoplay;
		}
	}

	@media(min-width: 768px) {

		.project {
			font-size: clamp(1em, 1.15em, 4em);
			padding: 2em 3em;
			gap: 2em;
		}

		.main-img img {
			width: 100%;
		}

		.gallery {
			width: 100%;
		}
	}

</style>
<script>
	const mainImage = document.getElementById('main') as HTMLImageElement;
	const thumbnails = document.querySelectorAll('.thumb') as NodeListOf<HTMLImageElement>;

	const originalSrc = mainImage.src;

	let revertTimer = 0;

	thumbnails.forEach(thumb => {
		thumb.addEventListener('click', () => {
			if (!mainImage)
				return;

			
			mainImage.style.opacity = '0.6';

			setTimeout(() => {
				mainImage.src = thumb.src;
				mainImage.style.opacity = '1';
			}, 150);

			clearTimeout(revertTimer);
			revertTimer = setTimeout(() => {
				mainImage.style.opacity = '0.6';
				setTimeout(() => {
					mainImage.src = originalSrc;
					mainImage.style.opacity = '1';
				}, 150);
			}, 10000);
		});
	});
</script>
